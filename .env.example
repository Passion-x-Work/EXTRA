# EXTRA 판정 프록시 환경변수. 이 파일을 .env 로 복사해서 값 채우기. (.env 는 git에 안 올라감)
# 전략: 제출·배포 = claude 전용 / 개발·테스트 = gpt+claude 둘 다 (드롭다운 전환 비교)

# provider: gpt | claude  (배포는 claude)
AI_PROVIDER=claude

# Claude (제출·배포 기본)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# GPT (개발·테스트/비교용)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 프록시 포트
PORT=8787
